// passthrough_action.rue -- a TEST leaf, never shipped in a pool's merkle tree.
//
// Returns whatever state and conditions its solution names, so the action layer
// and the multi-reserve finalizer can be driven with arbitrary states and
// tagged conditions before any real action exists. A pool whose merkle root
// contained this leaf would let anyone set its state; the integrity lane must
// refuse any root that includes it.

import super::upstream::action::StateTruth;

struct Output {
    state_truth: StateTruth,
    ...conditions: List<Condition>,
}

fn main(
    truth: StateTruth,
    new_state: Any,
    ...conditions: Any,
) -> Output {
    Output {
        state_truth: StateTruth {
            ephemeral_state: truth.ephemeral_state,
            actual_state: new_state,
        },
        conditions: unchecked_cast::<List<Condition>>(conditions),
    }
}
