// forge_action_dao_fee.rue -- Forge V12 `dao_fee` leaf. Testnet research only; unaudited.
//
// Lowers the pool's DAO fee. The recipient (CONFIG.dao_puzzle_hash) is curried and
// never changes; the rate lives in state so it can move, and this is the only leaf
// that moves it, in one direction: 0 <= new_bps < current. A pool at zero contains
// no transition to a nonzero rate, so irreversibility is topology, not a flag
// (FORGE_DAO_FEE_V11.md, V1 and V4).
//
// Authorization is the pool's own handshake turned around: a coin whose puzzle
// hash IS the DAO recipient sends a mode-23 message -- sender committed by puzzle
// hash, receiver by coin id -- naming the new rate. Consensus commits the receiver
// to THIS pool coin, so the message cannot be replayed against another pool or
// another spend of this one (V2). The DAO proves control of the recipient by
// spending a coin at it; no signature scheme enters the puzzle.
//
// Nothing else moves: reserves, LP, owed fees and the oracle are carried through
// the prologue untouched, so every reserve is re-created at its current amount
// (V3). The prologue still validates the config, pins the height and accumulates
// the oracle, as for any action.
//
// solution: h, new_bps

import upstream::action::StateTruth;
import forge_action_common::*;

fn main(
    CONFIG: PoolConfig,
    truth: StateTruth,
    h: Int,
    birth: Int,
    new_bps: Int,
) -> ActionOutput {
    let p = prologue(CONFIG, truth, h, birth);
    assert new_bps >= 0;
    assert new_bps < p.state.dao_fee_bps;
    assert CONFIG.dao_puzzle_hash != zero_bytes32();

    ActionOutput {
        state_truth: StateTruth {
            ephemeral_state: p.height,
            actual_state: ForgeState {
                reserves: p.state.reserves,
                total_lp: p.state.total_lp,
                fees_owed: p.state.fees_owed,
                oracle: p.state.oracle,
                prev_root: p.state.prev_root,
                dao_fee_bps: new_bps,
                dao_owed: p.state.dao_owed,
                reserve_parents: p.state.reserve_parents,
            },
        },
        conditions: concat(
            p.conditions,
            [
                ReceiveMessage {
                    mode: SENDER_PUZZLE | RECEIVER_COIN,
                    message: dao_fee_message(new_bps),
                    sender: [CONFIG.dao_puzzle_hash],
                },
            ],
        ),
    }
}
