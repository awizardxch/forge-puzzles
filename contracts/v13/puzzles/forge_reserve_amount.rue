// forge_reserve_amount.rue -- Forge V13's RESERVE_AMOUNT_PROGRAM.
//
// Curried into forge_multi_reserve_finalizer, which calls it twice per reserve:
// once on the pre-spend state from the truth (to derive the receiver coin id)
// and once on the new state (to size the recreated coin). Reserve coin `i` holds
// its curve reserve plus the protocol fees accrued against it, because V12 keeps
// owed fees inside the reserve as state rather than paying a second coin per
// swap; `collect` zeroes fees_owed[i] and tags a payout for the same reserve.
//
// An index with no entry fails (`first` of nil), which is what the finalizer's
// range check already guarantees never happens for a well-formed pool.
//
// The LP:reserve ratio plays no part here and must never be assumed: a vault
// opened at any lpRatio holds exactly reserves[0] + fees_owed[0] mojos.

struct ForgeState {
    reserves: List<Int>,
    total_lp: Int,
    fees_owed: List<Int>,
    oracle: Any,
    prev_root: Bytes32,
    dao_fee_bps: Int,
    dao_owed: List<Int>,
    reserve_parents: List<Bytes32>,
}

fn nth(list: List<Int>, index: Int) -> Int {
    if list is nil {
        // Out of range: there is no such reserve. Fail the spend.
        assert false;
        0
    } else if index == 0 {
        list.first
    } else {
        nth(list.rest, index - 1)
    }
}

// the DAO fee owed on a reserve sits inside it too, until `collect`.
fn main(state: ForgeState, index: Int) -> Int {
    assert index >= 0;
    nth(state.reserves, index) + nth(state.fees_owed, index) + nth(state.dao_owed, index)
}
