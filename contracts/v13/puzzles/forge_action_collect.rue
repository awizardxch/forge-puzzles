// forge_action_collect.rue -- Forge V13 `collect` leaf. Testnet research only; unaudited.
//
// Pays the accrued protocol fees out of the named reserves to the curried
// recipient, and zeroes them in state. Permissionless: the recipient is config
// and the amounts are state, so the caller chooses only WHEN, never where or how
// much. Each named index must hold a positive fee -- naming one twice fails on
// the second visit, since the first zeroed it.
//
// the DAO fee owed on the same reserve is paid in the same visit, to the
// curried DAO recipient, and zeroed too. An index qualifies when either fee is
// positive; a zero fee simply pays no coin.
//
// solution: h, indices   (a non-empty list of asset indices)

import upstream::action::StateTruth;
import forge_action_common::*;

struct Collected {
    fees_owed: List<Int>,
    dao_owed: List<Int>,
    ...conditions: List<Condition>,
}

fn payout(index: Int, recipient: Bytes32, amount: Int, rest: List<Condition>) -> List<Condition> {
    if amount > 0 {
        (
            for_reserve(index, CreateCoin {
                puzzle_hash: recipient,
                amount: amount,
                memos: Memos {
                    value: [recipient],
                },
            }),
            rest
        )
    } else {
        rest
    }
}

fn collect(
    fees_owed: List<Int>,
    dao_owed: List<Int>,
    indices: List<Int>,
    protocol_puzzle_hash: Bytes32,
    dao_puzzle_hash: Bytes32,
) -> Collected {
    if indices is nil {
        Collected { fees_owed: fees_owed, dao_owed: dao_owed, conditions: nil }
    } else {
        let index = indices.first;
        let fee = nth_int(fees_owed, index);
        let dao = nth_int(dao_owed, index);
        assert fee > 0 || dao > 0;
        let rest = collect(set_at(fees_owed, index, 0), set_at(dao_owed, index, 0), indices.rest,
                           protocol_puzzle_hash, dao_puzzle_hash);
        Collected {
            fees_owed: rest.fees_owed,
            dao_owed: rest.dao_owed,
            // V13: one recipient, one coin. Two CreateCoins for the same puzzle hash and
            // amount from the same reserve are one coin id twice, and the bundle fails as
            // DUPLICATE_OUTPUT with the fees still owed -- second audit M-1.
            conditions: if protocol_puzzle_hash == dao_puzzle_hash {
                payout(index, protocol_puzzle_hash, fee + dao, rest.conditions)
            } else {
                payout(index, protocol_puzzle_hash, fee,
                       payout(index, dao_puzzle_hash, dao, rest.conditions))
            },
        }
    }
}

fn main(
    CONFIG: PoolConfig,
    truth: StateTruth,
    h: Int,
    birth: Int,
    indices: List<Int>,
) -> ActionOutput {
    let p = prologue(CONFIG, truth, h, birth);
    assert !(indices is nil);
    let collected = collect(p.state.fees_owed, p.state.dao_owed, indices,
                            CONFIG.protocol_puzzle_hash, CONFIG.dao_puzzle_hash);

    ActionOutput {
        state_truth: StateTruth {
            ephemeral_state: p.height,
            actual_state: ForgeState {
                reserves: p.state.reserves,
                total_lp: p.state.total_lp,
                fees_owed: collected.fees_owed,
                oracle: p.state.oracle,
                prev_root: p.state.prev_root,
                dao_fee_bps: p.state.dao_fee_bps,
                dao_owed: collected.dao_owed,
                reserve_parents: p.state.reserve_parents,
            },
        },
        conditions: concat(p.conditions, collected.conditions),
    }
}
