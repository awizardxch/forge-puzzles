// forge_action_swap.rue -- Forge V13 `swap` leaf. Testnet research only; unaudited.
//
// V10's MODE_SWAP as a merkle leaf. Exactly one reserve rises and one falls; the
// claimed output is bracketed by exact_swap_output (moved from V10 unchanged);
// the protocol fee is a slice of the output, ACCRUED into fees_owed rather than
// paid as a second coin -- `collect` pays it out in batches. The trader receives
// the curve output minus the fee at the offer settlement puzzle, exactly as V10.
//
// solution: h, asset_in, asset_out, gross_input, claimed_output, settlement_coin_id
//
// Every other reserve is untouched by construction: only two indices are
// rewritten, and the finalizer re-creates every reserve from the new state.

import upstream::action::StateTruth;
import forge_curve::*;
import forge_action_common::*;

fn main(
    CONFIG: PoolConfig,
    truth: StateTruth,
    h: Int,
    birth: Int,
    asset_in: Int,
    asset_out: Int,
    gross_input: Int,
    claimed_output: Int,
    settlement_coin_id: Bytes32,
) -> ActionOutput {
    let p = prologue(CONFIG, truth, h, birth);
    let n = count_ints(p.state.reserves);
    // The five checks below are DEFENCE IN DEPTH, not the defence. Mutation
    // testing on 2026-09-10 (scripts/mutate-v12.py) deleted each in turn and the
    // suite still passed for four of them: `exact_swap_output` is unsatisfiable
    // for a negative or zero amount, and an out-of-range index fails the reserve
    // lookup before any assert is reached. Only `asset_in != asset_out` is
    // independently pinned.
    //
    // They are kept because TibetSwap V2 was drained in August 2026 by exactly
    // the gap they close -- a swap that enforced one reserve up and one down but
    // never that the input be positive. If the curve's bracket were ever widened,
    // these become the defence, and nothing would notice them going. Do not
    // remove them on the grounds that a test still passes without them.
    assert asset_in != asset_out;
    assert asset_in >= 0 && asset_in < n;
    assert asset_out >= 0 && asset_out < n;
    assert gross_input > 0;
    assert claimed_output > 0;

    let reserve_in = nth_int(p.state.reserves, asset_in);
    let reserve_out = nth_int(p.state.reserves, asset_out);
    assert exact_swap_output(
        reserve_in,
        reserve_out,
        reserve_in + gross_input,
        reserve_out - claimed_output,
        nth_int(CONFIG.weights, asset_in),
        nth_int(CONFIG.weights, asset_out),
        CONFIG.fee_bps,
    );
    let protocol_fee = protocol_fee_owed(claimed_output, CONFIG.protocol_fee_bps);
    // the DAO fee is a second slice of the same output, at the CURRENT rate in
    // state, owed inside the same reserve until `collect` pays it to the DAO.
    let dao_fee = protocol_fee_owed(claimed_output, p.state.dao_fee_bps);

    let new_state = ForgeState {
        reserves: add_at(add_at(p.state.reserves, asset_in, gross_input), asset_out, 0 - claimed_output),
        total_lp: p.state.total_lp,
        // The fee stays physically inside the out reserve, owed.
        fees_owed: add_at(p.state.fees_owed, asset_out, protocol_fee),
        oracle: p.state.oracle,
        prev_root: p.state.prev_root,
        dao_fee_bps: p.state.dao_fee_bps,
        dao_owed: add_at(p.state.dao_owed, asset_out, dao_fee),
        reserve_parents: p.state.reserve_parents,
    };

    ActionOutput {
        state_truth: StateTruth {
            ephemeral_state: p.height,
            actual_state: new_state,
        },
        conditions: concat(
            p.conditions,
            [
                settlement_assert(nth_bytes(CONFIG.asset_ids, asset_in), settlement_coin_id),
                for_reserve(asset_out, CreateCoin {
                    puzzle_hash: OFFER_MOD_HASH,
                    amount: claimed_output - protocol_fee - dao_fee,
                }),
            ],
        ),
    }
}
