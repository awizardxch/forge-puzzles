// forge_lp_cat_tail.rue -- Forge V11 pool-scoped LP CAT TAIL. Testnet research only; unaudited.
//
// V10's TAIL with one change: the pool's authorization arrives as a CHIP-0025
// message instead of a coin announcement. The pool SENDS with mode 23 -- sender
// committed by puzzle hash, receiver by coin id -- to the LP action coin whose id
// it derived (V10's lock, part 1). This TAIL RECEIVES against the pool's full
// singleton puzzle hash, rebuilt from its curried launcher id and the pool's
// inner puzzle hash supplied in the solution, the way forge_reserve_FORGE did.
// Consensus commits the receiving coin, so `AssertMyCoinId` and the action coin
// id in the message are gone; one condition replaces three.
//
// Everything else is V10, including the two locks this puzzle owns:
//   * `parent_is_cat || expected_delta > 0`: a melt destroys supply, so it can
//     only come from a coin that held supply. Without this a coin fabricated at
//     the melt puzzle hash out of ordinary mojos would score amount + delta and
//     let an attacker "burn" LP that never existed while the pool released
//     reserves -- security finding 4. CHIP-0040's standard TAIL lacks this line,
//     which is why it was declined for V11.
//   * `effective_delta == expected_delta`: the ring's real supply change is the
//     one the pool authorized, and the message also commits to the new supply
//     and the next state root.
//
// GENESIS. At creation the pool has not spent yet, so no singleton of its
// launcher can send a message; V10 let a creator-controlled coin vouch for the
// first mint. V11 uses the one coin whose id this TAIL already knows: the
// launcher. singleton_launcher announces sha256tree((full_puzzle_hash 1
// key_value_list)) exactly once, when it creates the eve. With the key-value
// list fixed here to (expected_delta), a genesis mint is possible only in the
// launcher's own bundle, only once, and only for the supply the launcher named.
// The registry's `register` asserts the same announcement with the list fixed
// to (total_lp), so a registered pool's genesis supply and its eve state agree.
// A pool nobody registers is creator-trusted at genesis, as V10 was -- and
// undiscoverable.
//
// Curried: (launcher_id, protocol_version). The tree hash is the LP asset id,
// unique per pool and per revision.

import forge_action_common::*;

// V11.1 (the DAO fee revision) is protocol 12: a fresh LP asset id per pool, so an
// LP of the earlier revision can never be authorized by a pool of this one.
inline const PROTOCOL_VERSION: Int = 12;

struct LpAction {
    expected_delta: Int,
    new_total_lp: Int,
    next_state_root: Bytes32,
    pool_inner_puzzle_hash: Bytes32,
    // zero for every mint and melt the pool authorizes by message; the pool's
    // full puzzle hash for the genesis mint the launcher authorizes
    genesis_pool_puzzle_hash: Bytes32,
}

fn main(
    launcher_id: Bytes32,
    protocol_version: Int,
    truths_any: Any,
    parent_is_cat_any: Any,
    _lineage_proof: Any,
    delta_any: Any,
    _inner_conditions: Any,
    action: LpAction,
) -> List<Condition> {
    assert launcher_id != zero_bytes32();
    assert protocol_version == PROTOCOL_VERSION;
    assert action.expected_delta != 0;
    assert action.new_total_lp >= 0;

    let parent_is_cat = unchecked_cast::<Bool>(parent_is_cat_any);
    let delta = unchecked_cast::<Int>(delta_any);
    let action_coin_amount = cat_my_amount(truths_any);
    assert action_coin_amount > 0;

    assert parent_is_cat || action.expected_delta > 0;

    let effective_delta = if parent_is_cat { delta } else { action_coin_amount + delta };
    assert effective_delta == action.expected_delta;

    if action.genesis_pool_puzzle_hash == zero_bytes32() {
        // The pool authorizes this supply change by message.
        assert action.pool_inner_puzzle_hash != zero_bytes32();
        let pool_full_puzzle_hash = curry_tree_hash(
            SINGLETON_MOD_HASH,
            [
                tree_hash((SINGLETON_MOD_HASH, (launcher_id, SINGLETON_LAUNCHER_PUZZLE_HASH))),
                action.pool_inner_puzzle_hash,
            ],
        );
        [
            ReceiveMessage {
                mode: SENDER_PUZZLE | RECEIVER_COIN,
                message: lp_message(action.expected_delta, action.new_total_lp, action.next_state_root),
                sender: [pool_full_puzzle_hash],
            },
        ]
    } else {
        // Genesis: a mint from nothing (no CAT parent) of exactly the supply the
        // launcher named when it created the eve at this puzzle hash.
        assert !parent_is_cat;
        assert action.expected_delta > 0;
        assert action.new_total_lp == action.expected_delta;
        [
            AssertCoinAnnouncement {
                id: sha256(launcher_id + tree_hash([action.genesis_pool_puzzle_hash, 1, [action.expected_delta]])),
            },
        ]
    }
}

// CAT2 truths:
// ((inner_puzzle_hash . cat_struct) .
//  (my_coin_id . (parent_coin_info, full_puzzle_hash, my_amount)))
fn cat_my_amount(truths: Any) -> Int {
    let outer = unchecked_cast::<(Any, Any)>(truths);
    let id_and_coin = unchecked_cast::<(Any, Any)>(outer.rest);
    let coin_info = unchecked_cast::<(Any, Any)>(id_and_coin.rest);
    let puzzle_hash_and_amount = unchecked_cast::<(Any, Any)>(coin_info.rest);
    let amount_and_nil = unchecked_cast::<(Any, Any)>(puzzle_hash_and_amount.rest);
    unchecked_cast::<Int>(amount_and_nil.first)
}
