// forge_curve.rue -- the Forge curve, ported from pool_singleton_FORGE.rue (V10).
//
// MOVED, NOT REWRITTEN. Every function body below is the V10 body. The curve
// has been probed for months and 16 pools passed the launch matrix on it; that
// evidence transfers to V12 only if the code does, and
// _test_v12_curve_equivalence.py holds this module to identical output against
// V10 on the recorded corpus of every real V10 spend (compiled/v10-spend-corpus.json)
// and against the V10 functions themselves on randomized inputs.
//
// The mechanical differences from V10, each of which the equivalence suite
// covers, are these and only these:
//
//   * reserves are `List<Int>` amounts rather than `List<ReserveState>`. V12
//     state carries plain amounts (reserve coin ids leave the state; the
//     finalizer derives them), so every `x.first.amount` became `x.first`.
//   * `valid_protocol_fees` no longer walks reserve plans. V12 has no plans: the
//     swap action knows which reserve shrinks and by how much, and the recipient
//     is curried rather than carried, so the arithmetic core is exposed as
//     `protocol_fee_owed(released, bps)` with the V10 name kept as its predicate.
//   * everything the V10 puzzle did around the curve -- pairwise-swap structure,
//     non-decreasing adds, mode dispatch, coin-id derivation -- belongs to the
//     actions, not here. This module is arithmetic only.
//
// V19 (external review 2026-11-16, finding 08) is the one deliberate change to a moved
// body: effective_product charges an unbalanced add's LP fee on a grossed-up base and also
// subtracts the dev and DAO fees (add_output_fees); exact_invariant_lp_mint carries all three
// rates. A balanced add and a vault add mint exactly as V10 did; an unbalanced one mints less.
//
// WEIGHTS ARE INTEGER UNITS, NOT BASIS POINTS. A pool keeps
// prod(reserve_i ** weight_i) constant, where each weight is a small positive
// integer and K is their sum. The puzzle never solves for an output, it only
// verifies one: both the mint and the swap are checked by bracketing -- the
// claimed value must hold the invariant, and one unit more must break it --
// which pins the result exactly using nothing but integer multiplication.

inline const WEIGHT_SCALE: Int = 10000;
// Fixed-point scale for the balanced-deposit ratio. Deposits are compared as
// fractions of their reserve, so this needs far more precision than bps.
inline const RATIO_SCALE: Int = 1000000000000;

export fn pow_int(base: Int, exp: Int) -> Int {
    if exp <= 0 {
        1
    } else {
        base * pow_int(base, exp - 1)
    }
}

export fn sum_weights(weights: List<Int>) -> Int {
    if weights is nil {
        0
    } else {
        weights.first + sum_weights(weights.rest)
    }
}

export fn product_of(reserves: List<Int>, weights: List<Int>) -> Int {
    if reserves is nil {
        1
    } else if weights is nil {
        1
    } else {
        pow_int(reserves.first, weights.first)
            * product_of(reserves.rest, weights.rest)
    }
}

// V19 (external review 2026-11-16, finding 08): `next` is the GROSS next (old + deposits),
// and the ratio, the growth factor and the gross-up scale are taken from it once. The add's
// LP fee and its dev and DAO fees (add_output_fees) are charged on a grossed-up base, and the
// dev and DAO fees leave the curve, so LP is minted against old + deposit - lp_fee - dev_fee -
// dao_fee per asset. Taking the ratio from the net reserves instead would let a rounding mojo
// on the min-ratio asset move every other asset's balanced amount.
export fn exact_invariant_lp_mint(
    old: List<Int>,
    next: List<Int>,
    weights: List<Int>,
    total_lp: Int,
    lp_delta: Int,
    fee_bps: Int,
    protocol_fee_bps: Int,
    dao_fee_bps: Int,
) -> Bool {
    let total_weight = sum_weights(weights);
    let new_total_lp = total_lp + lp_delta;
    let old_product = product_of(old, weights);
    let ratio = min_deposit_ratio(old, next);
    let growth = RATIO_SCALE + max_deposit_ratio(old, next);
    let scale = WEIGHT_SCALE - fee_bps - protocol_fee_bps - dao_fee_bps;
    let target = pow_int(total_lp, total_weight)
        * effective_product(old, next, weights, ratio, total_weight, fee_bps, protocol_fee_bps,
                            dao_fee_bps, growth, scale);
    // Largest mint whose K-th power stays within the weighted product ratio,
    // where K is the sum of the weights. With every weight at one this is the
    // N-th power bracket it replaces, and at two assets balanced it is the V5
    // square root.
    pow_int(new_total_lp, total_weight) * old_product <= target
        && pow_int(new_total_lp + 1, total_weight) * old_product > target
}

// Largest proportional deposit contained in the offered amounts. Anything above
// this per asset is imbalanced and has to be swapped by the pool internally.
export fn min_deposit_ratio(old: List<Int>, next: List<Int>) -> Int {
    if old is nil {
        0
    } else if next is nil {
        0
    } else if old.rest is nil {
        deposit_ratio(old.first, next.first)
    } else {
        min_int(
            deposit_ratio(old.first, next.first),
            min_deposit_ratio(old.rest, next.rest),
        )
    }
}

// V19 (finding 08): the LARGEST deposit ratio, for the growth factor below.
export fn max_deposit_ratio(old: List<Int>, next: List<Int>) -> Int {
    if old is nil {
        0
    } else if next is nil {
        0
    } else if old.rest is nil {
        deposit_ratio(old.first, next.first)
    } else {
        max_int(
            deposit_ratio(old.first, next.first),
            max_deposit_ratio(old.rest, next.rest),
        )
    }
}

fn deposit_ratio(old: Int, next: Int) -> Int {
    let (ratio, _) = divmod((next - old) * RATIO_SCALE, old);
    ratio
}

fn min_int(left: Int, right: Int) -> Int {
    if left < right {
        left
    } else {
        right
    }
}

fn max_int(left: Int, right: Int) -> Int {
    if left > right {
        left
    } else {
        right
    }
}

// V19: a division that rounds UP (toward the pool, for a non-negative numerator).
fn ceil_div(numerator: Int, denominator: Int) -> Int {
    let (quotient, _) = divmod(0 - numerator, denominator);
    0 - quotient
}

// LP is minted against the *effective* deposit: the balanced portion in full,
// the imbalanced excess net of the add's fees. Without this an unbalanced add followed
// by a pro-rata remove would be a cheaper swap.
//
// Only the (K - k_i)/K share of the excess is actually swapped -- the depositor
// already owns the share that stays in their own asset -- so the fees apply there.
//
// V19 (external review 2026-11-16, finding 08): every fee of an unbalanced add is charged on a
// GROSSED-UP base, rounded up, so an add followed by a remove of what it minted never pays the
// trader more than a swap of the same net input (measured by _test_v19_add_output_fees.py
// on 2-asset, weighted, 3-asset and rCAT pools, small to 10% of the
// reserves). With F the sum of the three rates, `scale` = W - F and `growth` = 1 + the largest
// deposit ratio (RATIO_SCALE fixed point):
//   lp_fee  = ceil(excess * fee * (K - k) * growth / (K * RATIO_SCALE * scale))
//   dev/dao = ceil(swap_base * rate / W), swap_base below.
// W / scale lifts the share to what a swap of the route's net input is charged on (that input
// already carries the add's fees); growth covers the depositor's own pro-rata claim on the LP
// fee it leaves in the pool and the curve's departure from the linear share at size. A vault
// keeps V8's LP fee on the whole deposit and books no dev or DAO fee.
export fn effective_product(
    old: List<Int>,
    next: List<Int>,
    weights: List<Int>,
    ratio: Int,
    total_weight: Int,
    fee_bps: Int,
    protocol_fee_bps: Int,
    dao_fee_bps: Int,
    growth: Int,
    scale: Int,
) -> Int {
    if old is nil {
        1
    } else if next is nil {
        1
    } else if weights is nil {
        1
    } else {
        let deposit = next.first - old.first;
        let (balanced, _) = divmod(old.first * ratio, RATIO_SCALE);
        let excess = deposit - balanced;
        // A vault holds all the weight in one asset, so there is nothing to be imbalanced
        // against: the deposit IS the trade, the full LP fee applies to it, and the withheld
        // part stays with the existing holders.
        // V17: `total_weight` is a sum and always canonical, and `weights.first` is the
        // curried atom, so `+ 0` makes this a comparison of canonical values.
        let holds_all_weight = weights.first + 0 == total_weight;
        let (vault_fee, _) = divmod(deposit * fee_bps * total_weight, total_weight * WEIGHT_SCALE);
        let fee_amount = if holds_all_weight {
            vault_fee
        } else {
            ceil_div(excess * fee_bps * (total_weight - weights.first) * growth,
                     total_weight * RATIO_SCALE * scale)
        };
        // V19 (finding 08): the dev and DAO slices of this asset's grossed-up swapped share.
        let base = swap_base(old.first, next.first, weights.first, ratio, total_weight, growth, scale);
        let proto_fee = ceil_div(base * protocol_fee_bps, WEIGHT_SCALE);
        let dao_fee = ceil_div(base * dao_fee_bps, WEIGHT_SCALE);
        pow_int(old.first + deposit - fee_amount - proto_fee - dao_fee, weights.first)
            * effective_product(old.rest, next.rest, weights.rest, ratio, total_weight, fee_bps,
                                protocol_fee_bps, dao_fee_bps, growth, scale)
    }
}

// V19 (external review 2026-11-16, finding 08): the base the add's dev and DAO fees are charged
// on. The swapped share -- the (K - k_i)/K share of the excess over the balanced deposit, the
// share the LP fee is charged on -- grossed up by W / scale and by growth, rounded up. Zero for a
// vault (one asset holds all the weight: nothing to trade against) and, up to a rounding mojo,
// for the asset that sets the min ratio. `+ 0` compares canonical values, as in effective_product.
fn swap_base(old: Int, next: Int, weight: Int, ratio: Int, total_weight: Int, growth: Int, scale: Int) -> Int {
    let (balanced, _) = divmod(old * ratio, RATIO_SCALE);
    let excess = next - old - balanced;
    if weight + 0 == total_weight {
        0
    } else {
        let (swapped, _) = divmod(excess * (total_weight - weight), total_weight);
        ceil_div(swapped * WEIGHT_SCALE * growth, scale * RATIO_SCALE)
    }
}

fn add_fee_list(old: List<Int>, next: List<Int>, weights: List<Int>, ratio: Int, total_weight: Int,
                growth: Int, scale: Int, bps: Int) -> List<Int> {
    if old is nil {
        nil
    } else if next is nil {
        nil
    } else if weights is nil {
        nil
    } else {
        [
            ceil_div(swap_base(old.first, next.first, weights.first, ratio, total_weight, growth, scale) * bps, WEIGHT_SCALE),
            ...add_fee_list(old.rest, next.rest, weights.rest, ratio, total_weight, growth, scale, bps),
        ]
    }
}

// V19 (finding 08): per asset, (dev fee, DAO fee) owed by an add -- ceil(swap_base * rate / W)
// for each rate -- booked in the deposited asset. The same terms effective_product subtracts, so
// the mint bracket and the add leaf's ledgers agree. `next` is the GROSS next; the ratio, growth
// and scale are derived from it here exactly as exact_invariant_lp_mint derives them.
export fn add_output_fees(
    old: List<Int>,
    next: List<Int>,
    weights: List<Int>,
    fee_bps: Int,
    protocol_fee_bps: Int,
    dao_fee_bps: Int,
) -> (List<Int>, List<Int>) {
    let total_weight = sum_weights(weights);
    let ratio = min_deposit_ratio(old, next);
    let growth = RATIO_SCALE + max_deposit_ratio(old, next);
    let scale = WEIGHT_SCALE - fee_bps - protocol_fee_bps - dao_fee_bps;
    (
        add_fee_list(old, next, weights, ratio, total_weight, growth, scale, protocol_fee_bps),
        add_fee_list(old, next, weights, ratio, total_weight, growth, scale, dao_fee_bps),
    )
}

// `fee_bps` is zero for every multi-asset pool, which leaves exact_withdrawal
// exactly proportional -- scaling by (10000 - 0)/10000 changes no value. It is
// non-zero only for a vault, where crossing between the LP and the one reserve
// IS the trade, so the pool's LP fee applies to it. What is withheld stays in
// the reserve, which is how a vault earns from the routing flow it carries.
export fn vault_fee_bps(reserves: List<Int>, fee_bps: Int) -> Int {
    if reserves is nil {
        0
    } else if reserves.rest is nil {
        fee_bps
    } else {
        0
    }
}

export fn exact_withdrawal(
    old: List<Int>,
    next: List<Int>,
    burn: Int,
    total_lp: Int,
    fee_bps: Int,
) -> Bool {
    if old is nil {
        next is nil
    } else if next is nil {
        false
    } else {
        let (withdrawal, _) = divmod(
            old.first * burn * (WEIGHT_SCALE - fee_bps),
            total_lp * WEIGHT_SCALE,
        );
        next.first == old.first - withdrawal
            && exact_withdrawal(old.rest, next.rest, burn, total_lp, fee_bps)
    }
}

export fn exact_swap_output(
    reserve_in: Int,
    reserve_out: Int,
    next_in: Int,
    next_out: Int,
    weight_in: Int,
    weight_out: Int,
    fee_bps: Int,
) -> Bool {
    let gross_input = next_in - reserve_in;
    let (effective_input, _) = divmod(
        gross_input * (WEIGHT_SCALE - fee_bps),
        WEIGHT_SCALE,
    );
    let charged_in = reserve_in + effective_input;
    // Only the traded pair moves, so every untouched reserve contributes the
    // same factor to both sides of the invariant and cancels. What remains is
    // reserve_in^k_in * reserve_out^k_out, bracketed: the claimed output must
    // hold the invariant, and one mojo more must break it. That pins the output
    // exactly without ever taking a root.
    let floor_invariant = pow_int(reserve_in, weight_in) * pow_int(reserve_out, weight_out);
    let claimed = pow_int(charged_in, weight_in) * pow_int(next_out, weight_out);
    let greedy = pow_int(charged_in, weight_in) * pow_int(next_out - 1, weight_out);
    effective_input > 0
        && next_out > 0
        && next_out < reserve_out
        && claimed >= floor_invariant
        && greedy < floor_invariant
}

// The protocol fee is a slice of what a swap releases, so it is only ever owed
// by the shrinking side of a swap. Deposits and withdrawals move liquidity
// rather than trade it and are charged nothing. V10 computed this per reserve
// plan; the arithmetic is unchanged.
export fn protocol_fee_owed(released: Int, protocol_fee_bps: Int) -> Int {
    let (amount, _) = divmod(released * protocol_fee_bps, WEIGHT_SCALE);
    amount
}

export fn valid_protocol_fees(fee_amount: Int, released: Int, protocol_fee_bps: Int) -> Bool {
    fee_amount == protocol_fee_owed(released, protocol_fee_bps)
}
